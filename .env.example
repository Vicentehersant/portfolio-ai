# Portfolio AI — copy to .env for local dev, or set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# REQUIRED — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — model id (default: claude-haiku-4-5)
CHAT_MODEL=
# Optional — path to your knowledge base, relative to the project root (default: config/knowledge.json)
KNOWLEDGE_FILE=
# Optional — max chat requests per IP per hour (default: 20)
RATE_LIMIT_MAX=

# Optional — Supabase logging + lead storage (run supabase/schema.sql first).
# The service role key is SERVER-ONLY. Never expose it in front-end code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — lead notification email via https://resend.com
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
# Required for lead email: sender address on a domain verified in Resend (format: Name <address>)
LEAD_FROM_EMAIL=
# Set to "off" to disable lead capture even when Supabase/Resend are configured
LEAD_CAPTURE=

# Optional — enables GET /api/usage-stats (send it as the x-admin-key header). Long random string.
ADMIN_DASHBOARD_KEY=
# Optional — protects /api/keepalive (Vercel Cron sends it automatically)
CRON_SECRET=
