{
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "crons": [{ "path": "/api/keepalive", "schedule": "0 9 * * *" }]
}
